# Zoho CRM — twl_campaign function execute URL (includes auth_type=apikey&zapikey=...)
# Generate from: Zoho CRM → Setup → Developer Space → Functions → twl_campaign → REST API
ZOHO_CRM_FUNCTION_EXECUTE_URL=

# Resend — email each successful lead. If this is unset, the lead is still sent to Zoho
# and the notification is skipped (a warning is logged).
# Create a key at https://resend.com/api-keys with permission to send email.
RESEND_API_KEY=

# Optional. Defaults to: Growth Spark Co. Leads <leads@growthsparkco.com>
# The domain in this address must be verified in Resend before mail will send.
LEAD_EMAIL_FROM=

# Optional. Comma-separated recipients. Defaults to cs@growthsparkco.com
LEAD_NOTIFY_TO=
